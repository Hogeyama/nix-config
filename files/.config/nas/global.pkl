// ---------------------------------------------------------------------------
// 共通ブロック（各プロファイルから参照される共有設定）
// ---------------------------------------------------------------------------

amends "Schema.pkl"

local commonEnv: Listing<EnvConfig> = new {
  new { key = "TZ"; val = "Asia/Tokyo" }
  new { key = "LANG"; val = "en_US.UTF-8" }
  // hostexecのgpgで署名する
  new { key = "GIT_CONFIG_COUNT"; val = "1" }
  new { key = "GIT_CONFIG_KEY_0"; val = "gpg.program" }
  new { key = "GIT_CONFIG_VALUE_0"; val = "gpg" }
  new { key = "TERM"; val = "xterm-256color" }
  new {
    key = "GITHUB_TOKEN"
    val = "dummy"
  }
  new {
    key = "PATH"
    val = "~/.nix-profile/bin"
    mode = "suffix"
    separator = ":"
  }
  new {
    key = "PATH"
    val = "/run/current-system/sw/bin"
    mode = "suffix"
    separator = ":"
  }
  new {
    key = "PATH"
    val = "~/.local/share/pnpm/bin"
    mode = "suffix"
    separator = ":"
  }
}

// ---------------------------------------------------------------------------
// network
//
// nas 0.15 で reviewRules / ReviewRule は廃止され、network.scopes の Scope と
// Rule に置き換わった。ホスト単位の allow/deny は「ターゲット集合を持つスコープ
// + その fallback」で表す。旧 catch-all の `new { action = "review" }` に対応
// するのは network.fallback = "review"（どのスコープにも属さないホストの帰結）。
// 同じ帰結しか持たないホストは 1 スコープに畳んでよい。
//
// https://github.com/Hogeyama/nix-agent-sandbox/blob/develop/docs/migration/network-scopes.md
// ---------------------------------------------------------------------------

// GitHub へのアクセスはここに含まれる owner のリポジトリに限定する。
// プロンプトインジェクションや情報漏洩の経路を狭めるため。
local githubOwners: Listing<String> = new { "Hogeyama" }

// GitHub への認証ヘッダを注入するスコープの雛形。
// rules にマッチしないリクエストは手動確認にする。
local githubAuthenticatedScope: Scope = new {
  targets {}
  fallback = "review"
  secrets = new {
    ["github-token"] = "inject"
  }
  inject {
    new {
      name = "authorization"
      value = "template:Bearer ${github-token}"
    }
  }
}

local commonNetwork: NetworkConfig = new {
  requestBodyAudit {
    enable = true
  }

  fallback = "review"

  scopes {
    ["anthropic"] = module.presets.anthropic.v1

    // --- deny (telemetry / 自動アクセス) ---
    ["telemetry"] {
      targets {
        // Claude Codeがなんか送ってるやつ
        "http-intake.logs.us5.datadoghq.com"
        // Copilot CLIがなんか送ってるやつ
        "copilot-telemetry.githubusercontent.com"
      }
      fallback = "deny"
    }

    // Chrome / Chromiumが勝手にアクセスするやつ
    ["google-phone-home"] {
      targets {
        "www.google.com"
        "mtalk.google.com"
        "clients2.google.com"
        "accounts.google.com"
        "android.clients.google.com"
        "content-autofill.googleapis.com"
        "dl.google.com"
        "edgedl.me.gvt1.com"
      }
      fallback = "deny"
    }

    // VS Codeが勝手にアクセスするやつ
    ["vscode"] {
      targets {
        "mobile.events.data.microsoft.com"
        "default.exp-tas.com"
        "westus-0.in.applicationinsights.azure.com"
        "o33249.ingest.us.sentry.io"
        "embeddings.vscode-cdn.net" // これは許可してもいいのかも
      }
      fallback = "deny"
    }

    // --- allow ---
    // WebSocket はスコープ単位の opt-in（既定 deny）。codex は chatgpt.com に
    // WebSocket で繋ぐので、その 2 ホストだけ別スコープに切って開ける。
    ["openai-ws"] {
      targets {
        "api.openai.com:443"
        "chatgpt.com:443"
      }
      webSocket = "allow"
      fallback = "allow"
    }

    // REST / GraphQL API。githubOwners のリポジトリだけ自動許可する。
    ["github-api"] = (githubAuthenticatedScope) {
      targets { "api.github.com:443" }
      rules {
        ["rest"] {
          match {
            methods { "GET"; "HEAD" }
            paths {
              "/repos/{owner}/**"
              "/users/{owner}/**"
              "/orgs/{owner}/**"
              "/user"
              // 以下は GitHub Copilot の動作に必要
              "/copilot_internal/user"
              "/copilot_internal/v2/token"
            }
            captures { ["owner"] = githubOwners }
          }
          onMatch = "allow"
        }

        ["graphql"] {
          match {
            methods { "POST" }
            paths { "/graphql" }
            body { format = "json" }
          }
          onMatch = "allow"
          onIndeterminate = "review"
          expect {
            new BodyExpect {
              graphql {
                operations { "query" }
                // 自動許可する取得経路。
                // うっかり starredRepos などを許可するとプロンプトインジェクションの経路になる。
                fieldPaths {
                  "/repository/nameWithOwner"
                  "/repository/url"
                  "/repository/issues/nodes/number"
                  "/repository/issues/nodes/title"
                  "/repository/issues/nodes/body"
                  "/repository/issues/nodes/comments/nodes/body"
                  "/repository/issues/pageInfo/endCursor"
                  "/repository/issues/pageInfo/hasNextPage"
                  "/repository/pullRequests/nodes/number"
                  "/repository/pullRequests/nodes/title"
                  "/repository/pullRequests/nodes/body"
                  "/repository/pullRequests/nodes/comments/nodes/body"
                  "/repository/pullRequests/pageInfo/endCursor"
                  "/repository/pullRequests/pageInfo/hasNextPage"
                  "/repository/pullRequests/nodes/url"
                  "/repository/pullRequests/nodes/state"
                  "/repository/pullRequests/nodes/id"
                  "/repository/pullRequests/nodes/baseRefName"
                  "/repository/pullRequests/nodes/headRefName"
                  "/repository/pullRequests/nodes/isCrossRepository"
                  "/repository/pullRequests/nodes/headRepositoryOwner/id"
                  "/repository/pullRequests/nodes/headRepositoryOwner/login"
                  "/repository/pullRequests/nodes/headRepositoryOwner/name"
                  "/repository/defaultBranchRef/name"
                  "/repository/parent/id"
                  "/repository/parent/name"
                  "/repository/parent/owner/id"
                  "/repository/parent/owner/login"
                  "/repository/object/text"
                  "/organization/login"
                  "/user/login"
                  "/repositoryOwner/login"
                }
                // 各 root の出現ごとに、所有者を名指す引数が存在して
                // githubOwners に含まれることを要求する。
                fieldArguments {
                  ["/repository"]      { ["owner"] = githubOwners }
                  ["/organization"]    { ["login"] = githubOwners }
                  ["/user"]            { ["login"] = githubOwners }
                  ["/repositoryOwner"] { ["login"] = githubOwners }
                }
              }
              onViolation = "review"
            }
          }
        }
      }
    }

    // Web ページと git over HTTPS。githubOwners のリポジトリだけ自動許可する。
    ["github"] = (githubAuthenticatedScope) {
      targets { "github.com:443" }
      rules {
        // git over HTTPS。ref の取得は read に含まれるが、Basic 認証を付けるため
        // より狭いルールとして切り出す。
        ["git-refs"] {
          match {
            methods { "GET" }
            paths { "/{owner}/{repo}/info/refs" }
            captures { ["owner"] = githubOwners }
          }
          onMatch = "allow"
          secrets = new {
            ["github-basic"] = "inject"
          }
          inject {
            new {
              name = "authorization"
              value = "template:Basic ${github-basic}"
            }
          }
        }
        ["git-pack"] {
          match {
            methods { "POST" }
            paths {
              "/{owner}/{repo}/git-upload-pack"
              "/{owner}/{repo}/git-receive-pack"
            }
            captures { ["owner"] = githubOwners }
          }
          onMatch = "allow"
          secrets = new {
            ["github-basic"] = "inject"
          }
          inject {
            new {
              name = "authorization"
              value = "template:Basic ${github-basic}"
            }
          }
        }
        ["read"] {
          match {
            methods { "GET"; "HEAD" }
            paths { "/{owner}/**" }
            captures { ["owner"] = githubOwners }
          }
          onMatch = "allow"
        }
      }
    }

    // raw / archive / gist の配信も host 一括 allow にしない。
    ["github-content"] {
      targets {
        "raw.githubusercontent.com:443"
        "codeload.github.com:443"
        "gist.github.com:443"
        "gist.githubusercontent.com:443"
      }
      fallback = "review"
      rules {
        ["read"] {
          match {
            methods { "GET"; "HEAD" }
            paths { "/{owner}/**" }
            captures { ["owner"] = githubOwners }
          }
          onMatch = "allow"
        }
      }
    }

    // リリースのアップロード。認証ヘッダは付けるが許可は手動。
    ["github-uploads"] = (githubAuthenticatedScope) {
      targets { "uploads.github.com:443" }
    }

    ["allowed"] {
      targets {
        // Anthropic / Claude
        "api.anthropic.com"
        "statsig.anthropic.com"
        "platform.claude.com"
        "mcp-proxy.anthropic.com"
        "code.claude.com"
        "claude.ai"
        "downloads.claude.ai"

        // OpenAI / ChatGPT
        "*.api.openai.com"
        "ab.chatgpt.com"
        "developers.openai.com"

        // Google
        "storage.googleapis.com"

        // GitHub
        "release-assets.githubusercontent.com"
        // Copilot
        "api.githubcopilot.com"
        "telemetry.individual.githubcopilot.com"
        "api.individual.githubcopilot.com"
        "telemetry.business.githubcopilot.com"
        "api.business.githubcopilot.com"
        // 画像系
        "camo.githubusercontent.com"
        "avatars.githubusercontent.com"

        // Docker Hub
        "registry-1.docker.io"
        "auth.docker.io"
        "index.docker.io"
        "hub.docker.com"
        "www.docker.com"
        "production.cloudflare.docker.com"
        "download.docker.com"

        // Container Registries
        "gcr.io"
        "*.gcr.io"
        "ghcr.io"
        "mcr.microsoft.com"
        "*.data.mcr.microsoft.com"
        "public.ecr.aws"

        // Package Registries
        // nix
        "cache.iog.io"
        "cache.nixos.org"
        "channels.nixos.org"
        // npm
        "registry.npmjs.org"
        // deno
        "jsr.io"
        "deno.land"
        // Rust
        "index.crates.io"
        "static.crates.io"

        // IETF Datatracker
        "datatracker.ietf.org"
      }
      fallback = "allow"
    }
  }
}

local commonHostexec: HostExecConfig = new {
  installScript = true
  prompt {
    enable = true
    timeoutSeconds = 300
    defaultScope = "capability"
  }
  rules {
    new {
      id = "wl-paste"
      match {
        argv0 = "wl-paste"
      }
      cwd {
        mode = "workspace-or-session-tmp"
      }
      inheritEnv {
        mode = "minimal"
        keys = new Listing { "WAYLAND_DISPLAY"; "XDG_RUNTIME_DIR" }
      }
      approval = "allow"
    }
    new {
      // git commit/tag -S が呼ぶ形だけを通す:
      //   gpg --status-fd=2 -bsau <keyid>
      id = "gpg-git-sign"
      match {
        argv0 = "gpg"
        argRegex = "^--status-fd=2 -bsau [0-9A-Fa-f]{8,40}$"
      }
      cwd {
        mode = "workspace-or-session-tmp"
      }
      approval = "allow"
    }
    new {
      // mo の危険引数を遮断：
      //   --port/-p: forward-ports と衝突させるとホスト側 mo がコンテナから読める
      //   --bind/-b: 非ループバックへ bind されるとネットワーク越しに露出
      //   --dangerously-allow-remote-access: 安全プロンプトのバイパス
      //   絶対パス / ~ / .. を含む位置引数・値: workspace 外の host ファイル参照を禁止
      id = "mo-guard"
      match {
        argv0 = "mo"
        argRegex = #"((^|\s)(--port|-p|--bind|-b|--dangerously-allow-remote-access)(\s|=|$))|((^|\s|=)/)|((^|\s|=)~)|((^|\s|=|/)\.\.(\s|$|/))"#
      }
      cwd {
        mode = "workspace-or-session-tmp"
      }
      approval = "deny"
    }
    new {
      id = "mo"
      match {
        argv0 = "mo"
      }
      cwd {
        mode = "workspace-or-session-tmp"
      }
      approval = "allow"
    }
  }
}

// common_infra + common_network + common_env + common_hostexec を含むベースプロファイル
local baseProfile: Profile = new {
  // Profile class は agent を required とする。各プロファイルで上書きする。
  agent = "claude"
  // common_infra
  nix {
    enable = "auto"
    mountSocket = true
  }
  session {
    multiplex = true
  }
  docker {
    enable = false
    shared = true
  }
  display {
    sandbox = "none"
  }
  extraMounts {
    // gitignoreが居る
    new { src = "~/nix-config"; dst = "~/nix-config"; mode = "ro" }
    new { src = "~/.cache/nix-index/"; dst = "~/.cache/nix-index/"; mode = "ro" }
    new { src = "~/.nix-profile/bin"; dst = "~/.nix-profile/bin"; mode = "ro" }
    new { src = "~/.config/nvim"; dst = "~/.config/nvim"; mode = "ro" }
    new { src = "~/.config/tmux"; dst = "~/.config/tmux"; mode = "ro" }
    new { src = "~/.local/share/nvim"; dst = "~/.local/share/nvim"; mode = "ro" }
    new { src = "~/.local/share/pnpm"; dst = "~/.local/share/pnpm"; mode = "ro" }
    new { src = "~/repo"; dst = "~/repo"; mode = "rw" }
    new { src = "/run/current-system/sw/bin"; dst = "/run/current-system/sw/bin"; mode = "rw" }
  }
  network = commonNetwork
  env = commonEnv
  hostexec = commonHostexec
  secrets {
    ["github-token"] {
      from = "cmd:pass github/token/for-agent"
    }
    // git over HTTPS 用。base64("x-access-token:<token>") を値とする。
    ["github-basic"] {
      from = #"cmd:printf 'x-access-token:%s' "$(pass github/token/for-agent)" | base64 -w0"#
    }
    ["proxy-mask-test"] {
      from = "cmd:printf nas-proxy-mask-test-8f3c2b1a"
    }
  }
  mask = new MaskConfig {
    maskfs = false
    proxy = true
    filter = true
  }
  guide {
    enable = true
  }
  direnv {
    enable = true
  }
}

// ---------------------------------------------------------------------------
// Top-level config
// ---------------------------------------------------------------------------

default = "claude"

ui {
  enable = true
  port = 3939
  idleTimeout = 300
}

observability {
  enable = true
}

profiles {
  ["claude"] = (baseProfile) {
    agent = "claude"
    agentArgs = new Listing { "--dangerously-skip-permissions" }
  }

  // CodeCompanion.nvim から ACP (Agent Client Protocol) で叩くための claude。
  // nas はコンテナ内の claude-agent-acp を起動して stdio を中継するだけなので、
  // guide は ACP モードでは設定エラーになる (指示は CLAUDE.md 側で与える)。
  // session.multiplex は ACP では無視されるため解除不要。
  ["claude-acp"] = (baseProfile) {
    agent = "claude"
    mode = "acp"
    guide {
      enable = false
    }
  }

  ["qwen"] = (baseProfile) {
    agent = "claude"
    // OpenRouter の API key を使うので、proxy による Claude 認証情報の注入を止める
    agentState {
      auth = "shared"
    }
    agentArgs = new Listing { "--dangerously-skip-permissions" }
    env = (baseProfile.env) {
      new { key = "OPENROUTER_API_KEY";   valCmd = "pass openrouter_api_key" }
      new { key = "ANTHROPIC_BASE_URL";   val    = "https://openrouter.ai/api" }
      new { key = "ANTHROPIC_AUTH_TOKEN"; valCmd = "pass openrouter_api_key" }
      new { key = "ANTHROPIC_API_KEY";    val    = "" }
      new { key = "ANTHROPIC_MODEL";      val    = "qwen/qwen3.8-max" }
      new { key = "ANTHROPIC_DEFAULT_HAIKU_MODEL";  val = "qwen/qwen3.8-max" }
      new { key = "ANTHROPIC_DEFAULT_SONNET_MODEL"; val = "qwen/qwen3.8-max" }
      new { key = "ANTHROPIC_DEFAULT_OPUS_MODEL";   val = "qwen/qwen3.8-max" }
      new { key = "CLAUDE_CODE_SUBAGENT_MODEL";     val = "qwen/qwen3.8-max" }
    }
  }

  ["codex"] = (baseProfile) {
    agent = "codex"
    agentArgs = new Listing { "--dangerously-bypass-approvals-and-sandbox" }
    dbus {
      session {
        enable = true
        calls {
          new { name = "org.freedesktop.secrets"; rule = "org.freedesktop.Secret.Service.OpenSession" }
          new { name = "org.freedesktop.secrets"; rule = "org.freedesktop.Secret.Service.SearchItems" }
          new { name = "org.freedesktop.secrets"; rule = "org.freedesktop.Secret.Item.GetSecret" }
        }
      }
    }
  }

  ["copilot"] = (baseProfile) {
    agent = "copilot"
    agentArgs = new Listing { "--allow-all" }
  }
}
